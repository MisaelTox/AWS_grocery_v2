##############################################
# .gitignore
# GroceryMate Terraform Project
##############################################

# -----------------------------
# Terraform files
# -----------------------------
*.tfstate
*.tfstate.*
*.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform/
.terraform.lock.hcl

# -----------------------------
# Sensitive or personal data
# -----------------------------
*.pem
*.key
*.crt
*.p12
*.zip
*.env
*.bak
*.log
secrets.txt
# SSH & Private Keys
*.pem
*.key
*.pub
*.ppk
id_rsa
id_ed25519
.ssh/

# -----------------------------
# System & editor files
# -----------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.tmp
*.backup
*.retry

# -----------------------------
# Python-related (for app layer)
# -----------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
env/
venv/

# -----------------------------
# OS cache & local history
# -----------------------------
.cache/
.history/
.local/
.terraform/
